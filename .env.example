# Copy this file to .env and fill in the values.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Local Docker database (see docker-compose.yml)
DATABASE_URL=postgresql://industrialink:industrialink@localhost:5432/industrialink
# Used only by `npm test`; it is wiped on every test run.
TEST_DATABASE_URL=postgresql://industrialink:industrialink@localhost:5432/industrialink_test

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more
SESSION_DAYS=30

# Address of this API (used in file links) and where uploaded files are kept for now.
PUBLIC_URL=http://localhost:4000
UPLOAD_DIR=uploads

# Test login and test sign-up (POST /api/v1/auth/dev-login ...). Only on your own computer.
# The server refuses to start with this on in production.
DEV_LOGIN=true

# Web apps allowed to call the API (comma separated). Mobile apps do not need this.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Push notifications (Firebase). Leave empty to keep push off.
# The service account JSON from Firebase as one line:  base64 -i key.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT=
