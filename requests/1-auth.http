# Login, sign-up (test versions) and the current user.
# Start the API first: npm run dev   Then click "Send Request" above each request.

@base = http://localhost:4000/api/v1

### Is the API up? (also checks the database)
GET http://localhost:4000/health

### List demo users to log in as
GET {{base}}/auth/dev-users

### Log in as a worker (any phone format works)
# @name worker
POST {{base}}/auth/dev-login
Content-Type: application/json

{ "phone": "98765 43210" }

### Who am I? (uses the token from the request above)
GET {{base}}/auth/me
Authorization: Bearer {{worker.response.body.$.token}}

### Log out (the same token stops working)
POST {{base}}/auth/logout
Authorization: Bearer {{worker.response.body.$.token}}

### Log in as an employer
POST {{base}}/auth/dev-login
Content-Type: application/json

{ "email": "hr@konark.demo" }

### Blocked user: should fail with 403 BLOCKED
POST {{base}}/auth/dev-login
Content-Type: application/json

{ "phone": "9855566677" }

### Sign up a new worker (change the number each time, or you get 409)
# @name newWorker
POST {{base}}/auth/dev-signup/worker
Content-Type: application/json

{ "name": "Anil Munda", "phone": "9700000001" }

### Finish the welcome steps
POST {{base}}/auth/onboarding/complete
Authorization: Bearer {{newWorker.response.body.$.token}}

### Sign up a new employer (company starts as "pending")
POST {{base}}/auth/dev-signup/employer
Content-Type: application/json

{ "name": "Pooja Sahu", "email": "hr@paradip-bulk.demo", "companyName": "Paradip Bulk Handling" }

### My settings
GET {{base}}/me/settings
Authorization: Bearer {{newWorker.response.body.$.token}}

### Change settings
PATCH {{base}}/me/settings
Authorization: Bearer {{newWorker.response.body.$.token}}
Content-Type: application/json

{ "language": "or", "visibleToEmployers": false }
